# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
release
dist-ssr

# The bare `dist` rule above also swallows the vendored react18-json-view build,
# which is a committed artifact rather than local output. Re-include the
# directory itself: git will not descend into an excluded directory, so negating
# only the files inside it would never match.
!vendor/react18-json-view/dist/
!vendor/react18-json-view/dist/**
.playwriter-shots
*.local
*.env.*
!.env.development.local.example
Gemfile.lock

# Yarn Berry — ignore cache/state, allow committed config slots
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Editor directories and files
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Chrome build keys
dist.crx
dist.pem

# Generated visuals (bundle analysis, architecture diagrams, etc.)
.visuals/

# heroui-agents-md
.heroui-docs/

# Jekyll docs site (docs/) build output and caches — built locally for testing
# and rebuilt by GitHub Pages on deploy, so never needs to be committed
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/.sass-cache/